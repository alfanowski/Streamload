# Keep the build context (and image) lean. The Dockerfile only needs:
#   requirements.txt, streamload/, migrations/, alembic.ini, streamload.py,
#   deploy/entrypoint.sh

# VCS
.git/
.gitignore
.gitattributes
.github/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Python caches / build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
*.egg
dist/
build/
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Virtualenvs
venv/
.venv/
ENV/
env/

# Secrets / local env (never bake into an image)
.env
.env.*
secret/
config.json
login.json
domains.json
domains.json.sig

# Tests & docs (not needed at runtime)
tests/
**/test_*.py
docs/
README.md
*.md

# Local data / media / logs
data/
Video/
*.mkv
*.mp4
*.db
*.log
streamload.log*

# Deploy assets that belong on the host, NOT in the image
# (entrypoint.sh is the exception — it is copied in, so do NOT ignore it)
docker-compose.yml
Caddyfile
deploy/backup.sh

# Agent / OS cruft
.superpowers/
.claude/
.DS_Store
Thumbs.db
