# =============================================================================
# Streamload v3 — PRODUCTION environment template.
#
# Copy this to `.env.prod` ON THE VPS and fill in real values. The real
# `.env.prod` is git-ignored and MUST NEVER be committed.
#
#   cp .env.prod.example .env.prod
#   # then edit .env.prod with real secrets (see docs/DEPLOY.md for openssl cmds)
#
# CONSISTENCY RULE: the user / password / db name in DATABASE_URL must match the
# POSTGRES_* values exactly, and the host in DATABASE_URL must be `db` (the
# compose service name), port 5432.
# =============================================================================

# --- Postgres container credentials -----------------------------------------
# Read by the official postgres image AND by deploy/backup.sh + the healthcheck.
POSTGRES_USER=streamload
POSTGRES_PASSWORD=CHANGEME_strong_db_password
POSTGRES_DB=streamload

# --- App database URL (asyncpg form) ----------------------------------------
# The FastAPI app AND Alembic both read this single variable. Alembic's
# migrations/env.py drives an async engine with the asyncpg driver and uses this
# URL unchanged — do NOT convert it to a sync/psycopg URL.
# Host MUST be `db`; user/pass/dbname MUST match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://streamload:CHANGEME_strong_db_password@db:5432/streamload

# --- Third-party API keys ---------------------------------------------------
TMDB_API_KEY=CHANGEME_tmdb_api_key
RESEND_API_KEY=CHANGEME_resend_api_key
# From-address for transactional email (verification, etc.).
EMAIL_FROM=Streamload <noreply@capytal.tech>

# --- Admin bootstrap --------------------------------------------------------
# _ensure_admin_user() runs on every app boot. On first boot it creates this
# admin with the given password; on later boots it ensures the user exists,
# is role=admin and not disabled, but does NOT overwrite the password.
# Set STREAMLOAD_ADMIN_RESET_PASSWORD=1 ONCE to force a password reset on boot.
STREAMLOAD_ADMIN_USERNAME=admin
STREAMLOAD_ADMIN_EMAIL=admin@capytal.tech
STREAMLOAD_ADMIN_PASSWORD=CHANGEME_strong_admin_password
STREAMLOAD_ADMIN_RESET_PASSWORD=

# --- App runtime ------------------------------------------------------------
STREAMLOAD_LOG_LEVEL=INFO
# granian worker count. 1 is right for a 1 vCPU / 2 GB droplet.
GRANIAN_WORKERS=1

# --- Image tag (optional) ---------------------------------------------------
# docker-compose pins ghcr.io/alfanowski/streamload-api:${API_TAG:-latest}.
# Leave unset for :latest, or set to a specific :sha-<...> tag to pin/rollback.
# API_TAG=latest

# --- WebAuthn / Passkeys (current auth is username/password; these are vestigial
#     but the app still reads them, so keep them set to the prod host) ---------
WEBAUTHN_RP_ID=api.capytal.tech
WEBAUTHN_RP_NAME=Streamload
WEBAUTHN_ORIGIN=https://api.capytal.tech

# --- CORS (NOT yet consumed by the backend) ---------------------------------
# NOTE: as of this writing the backend does NOT install CORS middleware, so this
# value is currently a no-op. It is documented here so that when CORS is wired
# up (to allow the browser client at the web origin to call the API), the var is
# already in place. Set it to the real client web origin then. Adjust as needed.
# CORS_ALLOWED_ORIGINS=https://capytal.tech

# --- Test DB (not used in prod; leave blank) --------------------------------
DATABASE_URL_TEST=
